---
import Layout from "@layouts/Layout.astro"
import YardCard from "@components/YardCard.astro"
import StatCard from "@components/StatCard.astro"
import BirthsDeathsCard from "@components/BirthsDeathsCard.astro"
import { Users, Banknote } from "lucide-react"
---

<Layout>
  <section class="grid grid-cols-1 gap-4 p-2 md:grid-cols-3" id="stats">
    <StatCard title="Población total" icon={Users} description="Cuyes en todos los corrales">
      <p class="text-3xl font-semibold" data-field="totalPopulation">—</p>
    </StatCard>
    <StatCard title="Ingresos por ventas" icon={Banknote} description="Total acumulado de ventas">
      <p class="text-3xl font-semibold" data-field="salesRevenue">—</p>
    </StatCard>
    <BirthsDeathsCard />
  </section>

  <section class="flex flex-col gap-4 p-2">
    <h2 class="text-xl font-semibold">Corrales</h2>
    <p class="text-sm text-muted-foreground" id="yards-status">Cargando corrales...</p>
    <div class="flex flex-col gap-4" id="yards"></div>
    <template id="yard-card"><YardCard /></template>
  </section>
</Layout>

<script>
  import { getMovements } from "@/routes/movements"
  import { getYards } from "@/routes/yards"
  import { summarize } from "@/lib/dashboard"
  import { toast } from "@/components/ui/toast"

  // El sitio es estático, los datos se piden al backend desde el navegador
  const money = new Intl.NumberFormat("es-PE", { style: "currency", currency: "PEN" })
  const number = new Intl.NumberFormat("es-PE")

  const stats = document.getElementById("stats")!
  const yardsContainer = document.getElementById("yards")!
  const yardsStatus = document.getElementById("yards-status")!
  const yardTemplate = document.getElementById("yard-card") as HTMLTemplateElement

  function fill(root: ParentNode, values: Record<string, string>) {
    root.querySelectorAll<HTMLElement>("[data-field]").forEach((el) => {
      const value = values[el.dataset.field!]
      if (value !== undefined) el.textContent = value
    })
  }

  async function loadDashboard() {
    try {
      const [yards, movements] = await Promise.all([getYards(), getMovements()])
      const summary = summarize(yards, movements)

      const outcomes = summary.births + summary.deaths
      const birthsPct = outcomes ? Math.round((summary.births / outcomes) * 100) : 0
      const deathsPct = outcomes ? 100 - birthsPct : 0

      fill(stats, {
        totalPopulation: number.format(summary.totalPopulation),
        salesRevenue: money.format(summary.salesRevenue),
        births: number.format(summary.births),
        deaths: number.format(summary.deaths),
        birthsPct: `${birthsPct}%`,
        deathsPct: `${deathsPct}%`,
      })
      stats.querySelector<HTMLElement>('[data-bar="births"]')!.style.width = `${birthsPct}%`
      stats.querySelector<HTMLElement>('[data-bar="deaths"]')!.style.width = `${deathsPct}%`

      yardsContainer.replaceChildren(
        ...summary.yards.map((yard) => {
          const card = yardTemplate.content.cloneNode(true) as DocumentFragment
          fill(card, {
            name: yard.name,
            total: number.format(yard.total),
            males: number.format(yard.males),
            females: number.format(yard.females),
            notDefined: number.format(yard.notDefined),
            deaths: number.format(yard.deaths),
            births: number.format(yard.births),
            income: money.format(yard.income),
          })
          return card
        }),
      )
      yardsStatus.textContent = summary.yards.length ? "" : "Aún no hay corrales registrados."
      yardsStatus.hidden = summary.yards.length > 0
    } catch (error) {
      console.error("error: ", error)
      yardsStatus.hidden = false
      yardsStatus.textContent = "No se pudo cargar la información."
      toast.add({
        type: "error",
        description: "No se pudo cargar la información del dashboard.",
        priority: "high",
      })
    }
  }

  loadDashboard()
  // Los formularios avisan cuando registran un corral o movimiento
  window.addEventListener("cuy:data-changed", loadDashboard)
</script>
