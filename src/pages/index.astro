---
import Layout from "@layouts/Layout.astro"
import YardCard from "@components/YardCard.astro"
import StatCard from "@components/StatCard.astro"
import BirthsDeathsCard from "@components/BirthsDeathsCard.astro"
import { Users, Banknote } from "lucide-react"

const stats = {
  totalPopulation: 248,
  salesRevenue: 3640,
  births: 57,
  deaths: 14,
}

const yards = [
  { id: "1", name: "Corral 1", males: 40, females: 62, notDefined: 18, deaths: 3, births: 25, transfers: 6 },
  { id: "2", name: "Corral 2", males: 35, females: 55, notDefined: 21, deaths: 5, births: 20, transfers: 2 },
  { id: "3", name: "Corral 3", males: 12, females: 5, notDefined: 0, deaths: 6, births: 12, transfers: 8 },
]

const money = new Intl.NumberFormat("es-PE", { style: "currency", currency: "PEN" })
const number = new Intl.NumberFormat("es-PE")
---

<Layout>
  <section class="grid grid-cols-1 gap-4 p-2 md:grid-cols-3">
    <StatCard title="Población total" icon={Users} description="Cuyes en todos los corrales">
      <p class="text-3xl font-semibold">{number.format(stats.totalPopulation)}</p>
    </StatCard>
    <StatCard title="Ingresos por ventas" icon={Banknote} description="Total acumulado de ventas">
      <p class="text-3xl font-semibold">{money.format(stats.salesRevenue)}</p>
    </StatCard>
    <BirthsDeathsCard births={stats.births} deaths={stats.deaths} />
  </section>

  <section class="flex flex-col gap-4 p-2">
    <h2 class="text-xl font-semibold">Corrales</h2>
    {yards.map(({ id, ...yard }) => <YardCard {...yard} />)}
  </section>
</Layout>
