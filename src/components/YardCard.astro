---
import { Mars, Venus, Baby, Skull, Sprout, Banknote } from "lucide-react"

// Se usa como plantilla, el script de index.astro clona la tarjeta por cada corral y llena los data-field
const genders = [
  { label: "Machos", field: "males", icon: Mars },
  { label: "Hembras", field: "females", icon: Venus },
  { label: "Sin definir", field: "notDefined", icon: Baby },
]

const movements = [
  { label: "Bajas", field: "deaths", icon: Skull, color: "text-red-600" },
  { label: "Nacimientos", field: "births", icon: Sprout, color: "text-emerald-600" },
  { label: "Ingresos", field: "income", icon: Banknote, color: "text-sky-600" },
]
---

<article class="flex flex-col gap-4 rounded-xl border bg-card p-4 shadow-sm">
  <header class="flex items-baseline justify-between">
    <h3 class="text-lg font-semibold" data-field="name"></h3>
    <p class="text-sm text-muted-foreground">
      Total: <span class="text-2xl font-semibold text-foreground" data-field="total"></span>
    </p>
  </header>

  <ul class="grid grid-cols-3 gap-2">
    {
      genders.map(({ label, field, icon: Icon }) => (
        <li class="flex flex-col gap-1 rounded-lg bg-muted p-2">
          <span class="flex items-center gap-1 text-xs text-muted-foreground">
            <Icon size={14} />
            {label}
          </span>
          <span class="text-lg font-semibold" data-field={field}></span>
        </li>
      ))
    }
  </ul>

  <ul class="grid grid-cols-3 gap-2 border-t pt-3">
    {
      movements.map(({ label, field, icon: Icon, color }) => (
        <li class="flex flex-col gap-1">
          <span class="flex items-center gap-1 text-xs text-muted-foreground">
            <Icon size={14} className={color} />
            {label}
          </span>
          <span class={`text-lg font-semibold ${color}`} data-field={field}></span>
        </li>
      ))
    }
  </ul>
</article>
